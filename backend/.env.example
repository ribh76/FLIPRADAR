# Application
APP_NAME=FlipRadar
APP_ENV=development
APP_DEBUG=true
FRONTEND_URL=http://127.0.0.1:5173
APP_RELEASE=unknown

# Logging
LOG_LEVEL=INFO
SQLALCHEMY_LOG_LEVEL=WARNING
UVICORN_ACCESS_LOG_LEVEL=INFO

# Exception monitoring (optional; errors are reported only when a DSN is configured)
SENTRY_DSN=

# Database
DATABASE_URL=
ALEMBIC_DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=flipradar
DATABASE_USER=flipradar_app
DATABASE_PASSWORD=flipradar_dev_password
DATABASE_SSL_MODE=prefer
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_WAIT_TIMEOUT=60

# Authentication
JWT_SECRET_KEY=local-development-secret-change-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
ACCOUNT_TOKEN_RESEND_COOLDOWN_SECONDS=300
PASSWORD_MIN_LENGTH=8

# CORS
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Email
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=auth@flipradar.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=auth@flipradar.com
SMTP_PASSWORD=
AUTH_EMAIL_APP_PASSWORD=
EMAIL_TIMEOUT_SECONDS=10

# Marketplace APIs
EBAY_API_ENABLED=false
EBAY_API_CONFIGURED=false
EBAY_API_KEY=set-me-up-before-deployment
EBAY_API_SECRET=set-me-up-before-deployment
EBAY_API_TIMEOUT_SECONDS=10

BRICKLINK_API_ENABLED=false
BRICKLINK_API_CONFIGURED=false
BRICKLINK_CONSUMER_KEY=set-me-up-before-deployment
BRICKLINK_CONSUMER_SECRET=set-me-up-before-deployment
BRICKLINK_TOKEN_VALUE=set-me-up-before-deployment
BRICKLINK_TOKEN_SECRET=set-me-up-before-deployment
BRICKLINK_API_TIMEOUT_SECONDS=10

# Pricing
PRICING_CURRENCY=USD
PRICING_FRESHNESS_HOURS=24
PRICING_RETENTION_DAYS=180

# LLM APIs
LLM_ENABLED=false
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1500
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.25
LLM_USER_RATE_LIMIT=10
LLM_GLOBAL_RATE_LIMIT=100
LLM_RATE_LIMIT_WINDOW_SECONDS=60
# Keep these synchronized with the selected Anthropic model's published pricing.
LLM_INPUT_COST_PER_MILLION_TOKENS=3.00
LLM_OUTPUT_COST_PER_MILLION_TOKENS=15.00

# Supporting Services
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
WATCHLIST_WORKER_ENABLED=false
WATCHLIST_PROVIDER_HOURLY_LIMIT=60
