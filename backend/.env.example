APP_NAME=FlipRadar
APP_ENV=development
APP_DEBUG=true

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=flipradar
DATABASE_USER=flipradar_app
DATABASE_PASSWORD=replace-with-a-secure-password
DATABASE_SSL_MODE=prefer
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
