# Application
APP_NAME=FlipRadar
APP_ENV=development
APP_DEBUG=true
FRONTEND_URL=http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO
SQLALCHEMY_LOG_LEVEL=WARNING
UVICORN_ACCESS_LOG_LEVEL=INFO

# Database
DATABASE_URL=
ALEMBIC_DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=flipradar
DATABASE_USER=flipradar_app
DATABASE_PASSWORD=flipradar_dev_password
DATABASE_SSL_MODE=prefer
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_WAIT_TIMEOUT=60

# Authentication
JWT_SECRET_KEY=local-development-secret-change-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
ACCOUNT_TOKEN_RESEND_COOLDOWN_SECONDS=300
PASSWORD_MIN_LENGTH=8

# CORS
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Email
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=auth@flipradar.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=auth@flipradar.com
SMTP_PASSWORD=
AUTH_EMAIL_APP_PASSWORD=
EMAIL_TIMEOUT_SECONDS=10

# Marketplace APIs
EBAY_API_ENABLED=false
EBAY_API_CONFIGURED=false
EBAY_API_KEY=
EBAY_API_SECRET=
EBAY_API_TIMEOUT_SECONDS=10

BRICKLINK_API_ENABLED=false
BRICKLINK_API_CONFIGURED=false
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN_VALUE=
BRICKLINK_TOKEN_SECRET=
BRICKLINK_API_TIMEOUT_SECONDS=10

# LLM APIs
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1500

# Supporting Services
REDIS_URL=redis://localhost:6379/0
