VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_ERROR_REPORTING_ENABLED=false
# Build identifiers are public metadata, not secrets. Set both during production
# builds to the immutable release identifier (normally the Git commit SHA).
VITE_APP_ENV=development
VITE_APP_RELEASE=local
