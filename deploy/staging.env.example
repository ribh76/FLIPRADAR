# Copy to deploy/staging.env, replace every placeholder, and keep it outside Git.
# Both image values must identify the same already-certified release.
BACKEND_IMAGE=registry.example.com/flipradar/backend:IMMUTABLE_RELEASE
FRONTEND_IMAGE=registry.example.com/flipradar/frontend:IMMUTABLE_RELEASE
FRONTEND_PORT=8080

APP_RELEASE=IMMUTABLE_RELEASE
FRONTEND_URL=https://staging.example.com
CORS_ALLOWED_ORIGINS=https://staging.example.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@STAGING_DATABASE_HOST:5432/flipradar
DATABASE_SSL_MODE=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_WAIT_TIMEOUT=60
JWT_SECRET_KEY=REPLACE_WITH_A_UNIQUE_64_PLUS_CHARACTER_STAGING_SECRET
REDIS_URL=rediss://:PASSWORD@STAGING_REDIS_HOST:6379/0

LOG_LEVEL=INFO
SQLALCHEMY_LOG_LEVEL=WARNING
UVICORN_ACCESS_LOG_LEVEL=INFO
SENTRY_DSN=
ERROR_RATE_ALERT_THRESHOLD_PERCENT=5
ERROR_RATE_ALERT_MINIMUM_REQUESTS=20
ERROR_RATE_ALERT_WINDOW_SECONDS=300

EMAIL_ENABLED=false
EBAY_API_ENABLED=false
BRICKLINK_API_ENABLED=false
LLM_ENABLED=false
ALLOW_MOCK_MARKETPLACE_PROVIDERS=false
